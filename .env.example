# Parley Bot Configuration Template
# Rellena tus API Keys y guarda este archivo como .env

FOOTBALL_DATA_KEY=tu_api_key_de_football_data_aqui
BZZOIRO_API_KEY=tu_api_key_de_bzzoiro_aqui
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
TELEGRAM_CHAT_ID=tu_chat_id_de_telegram_aqui
TZ_LOCAL=America/Guayaquil

# Opcional: The Odds API (https://the-odds-api.com) para cuotas reales y filtro EV
ODDS_API_KEY=tu_api_key_de_the_odds_api_aqui
# EV mínimo para conservar un pick con cuota real (0.0 = solo EV positivo)
MIN_EV=0.0

# Opcional: PostgreSQL (Neon) para persistencia y auditoría nocturna
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
